{
  "$defs": {
    "touchstone.v1.Component.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "caveats": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "pattern": "^CONFIDENCE_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "CONFIDENCE_LOW",
                "CONFIDENCE_MEDIUM",
                "CONFIDENCE_HIGH"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "title": "Confidence"
        },
        "cpe": {
          "default": "",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/touchstone.v1.Evidence.jsonschema.json"
          },
          "type": "array"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "purl": {
          "default": "",
          "type": "string"
        },
        "version": {
          "default": "",
          "type": "string"
        },
        "vulnerabilities": {
          "items": {
            "$ref": "#/$defs/touchstone.v1.Vulnerability.jsonschema.json"
          },
          "type": "array"
        }
      },
      "title": "Component",
      "type": "object"
    },
    "touchstone.v1.Evidence.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "detail": {
          "default": "",
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "pattern": "^EVIDENCE_KIND_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "EVIDENCE_KIND_SBOM_PUBLISHED",
                "EVIDENCE_KIND_SBOM_SUPPLIED",
                "EVIDENCE_KIND_VEX",
                "EVIDENCE_KIND_REPO_LOCKFILE",
                "EVIDENCE_KIND_FINGERPRINT_ASSET",
                "EVIDENCE_KIND_FINGERPRINT_HEADER"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "title": "Evidence Kind"
        },
        "location": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Evidence",
      "type": "object"
    },
    "touchstone.v1.Vulnerability.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(cvss_base)$": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": [
                "Infinity",
                "-Infinity",
                "NaN"
              ],
              "type": "string"
            },
            {
              "type": "string"
            }
          ]
        },
        "^(vex_justification)$": {
          "default": "",
          "type": "string"
        },
        "^(vex_status)$": {
          "anyOf": [
            {
              "pattern": "^VEX_STATUS_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "VEX_STATUS_AFFECTED",
                "VEX_STATUS_NOT_AFFECTED",
                "VEX_STATUS_FIXED",
                "VEX_STATUS_UNDER_INVESTIGATION"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "title": "Vex Status"
        }
      },
      "properties": {
        "aliases": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cvssBase": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": [
                "Infinity",
                "-Infinity",
                "NaN"
              ],
              "type": "string"
            },
            {
              "type": "string"
            }
          ]
        },
        "epss": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": [
                "Infinity",
                "-Infinity",
                "NaN"
              ],
              "type": "string"
            },
            {
              "type": "string"
            }
          ]
        },
        "id": {
          "default": "",
          "type": "string"
        },
        "kev": {
          "default": false,
          "type": "boolean"
        },
        "summary": {
          "default": "",
          "type": "string"
        },
        "suppressed": {
          "default": false,
          "type": "boolean"
        },
        "vexJustification": {
          "default": "",
          "type": "string"
        },
        "vexStatus": {
          "anyOf": [
            {
              "pattern": "^VEX_STATUS_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "VEX_STATUS_AFFECTED",
                "VEX_STATUS_NOT_AFFECTED",
                "VEX_STATUS_FIXED",
                "VEX_STATUS_UNDER_INVESTIGATION"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "title": "Vex Status"
        }
      },
      "title": "Vulnerability",
      "type": "object"
    }
  },
  "$id": "touchstone.v1.Component.jsonschema.bundle.json",
  "$ref": "#/$defs/touchstone.v1.Component.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
